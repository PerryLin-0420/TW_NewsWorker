  "schedule": {
    "daily": "08:00"
  },
  "crawler": {
    "max_articles_per_source": 25,
    "request_timeout": 15,
    "request_delay_seconds": 1,
    "max_content_chars": 3000,
    "max_fetch_workers": 12,
    "skip_fetch_domains": ["bloomberg.com"]
  },
  "selector": {
    "top_n_per_region": 6,
    "max_articles_per_event": 2,
    "max_event_size": 8,
    "cluster_min_shared_terms": 2,
    "cluster_jaccard_threshold": 0.34,
    "keyword_bonus": 2.0,
    "baseline_window_days": 7,
    "min_burst_score": 1.0,
    "min_baseline_docs_floor": 1000,
    "relevance": {
      "enabled": true,
      "drop_below": 0.4,
      "keyword_drop_below": 0.3,
      "penalty_below": 0.6,
      "penalty_factor": 0.5,
      "high_min": 0.5,
      "tw_neutral_band": 0.5
    }
  },
  "event_threads": {
    "dormant_after_days_single": 4,
    "dormant_after_days_multi": 10
  },
  "summarizer": {
    "delay_between_calls_seconds": 3,
    "timeout_seconds": 240
  },
  "monitor": {
    "source_failure_alert_threshold": 6,
    "log_lines_in_alert": 60
  },
  "market_correlation": {
    "rolling_window_days": 60,
    "recent_days": 63,
    "z_threshold": 2.0,
    "min_baseline_obs": 30
  }
