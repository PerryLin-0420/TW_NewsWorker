# 複製此檔為 .env 並填入真實值（.env 已被 .gitignore 排除，切勿提交）
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
RECIPIENT_EMAIL=recipient@example.com
# 選填：額外收件人
RECIPIENT_EMAIL_2=

# 用 `claude.exe setup-token` 產生的長期 token（走 Claude 訂閱，非另計費 API key）。
# 排程無人值守，不能靠 shell 的 `export` 傳遞，必須放這裡讓 claude_cli.py 讀取。
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
